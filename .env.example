# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# VED AFFILIATE PVT. LIMITED - Environment Configuration
# ========================================================

# Backend Server Environment
NODE_ENV=development
PORT=3001

# MongoDB Atlas Database Connection
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/ved_affiliate?retryWrites=true&w=majority
MONGODB_URI=""

# JWT Secret for Partner Session Authentication
# Use a unique random value of at least 32 characters. Render can generate this value.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Frontend CORS Origin (For Render/Vercel split deployments)
# Multiple origins may be comma-separated.
FRONTEND_URL="https://ved-affaliate-marketing.vercel.app"

# Frontend API Base URL (leave empty for same-domain dev or set for external Render URL)
VITE_API_BASE_URL=""

# Render supplies PORT automatically. Set NODE_ENV=production and configure
# MONGODB_URI, JWT_SECRET, and FRONTEND_URL in the Render service dashboard.

# Production SMTP Email Configuration (for password reset notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="vedaffiliateltd@gmail.com"
SMTP_PASS=""
EMAIL_FROM="VED AFFILIATE PVT. LIMITED <vedaffiliateltd@gmail.com>"
